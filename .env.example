# --- Browser (exposed to the client bundle; safe: protected by RLS) ---
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# --- Server only (Vercel Functions; never prefix with VITE_) ---
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
META_ACCESS_TOKEN=your-long-lived-system-user-token
# Required: /api/sync-meta refuses to run without it. Generate with: openssl rand -hex 32
CRON_SECRET=generate-a-long-random-string
